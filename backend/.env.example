#########################################
# Arquivo de exemplo de variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores locais
# NÃO comite o arquivo `.env` com secrets reais
#########################################

# Server
PORT=3000
NODE_ENV=development

# Database (MySQL)
# Ajuste conforme seu ambiente local
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=chatbot
DB_NAME=fsphemo_db

# JWT
# Defina uma chave forte (mínimo 32 bytes hex) em produção
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Misc
# Salvar import de estoque localmente? (true/false)
SAVE_LOCAL=false
